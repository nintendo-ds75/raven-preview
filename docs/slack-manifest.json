{
  "display_information": {
    "name": "Raven",
    "description": "Human judgment for coding agents",
    "background_color": "#14231b"
  },
  "features": {
    "bot_user": {
      "display_name": "Raven",
      "always_online": false
    },
    "app_home": {
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "agent_view": {
      "agent_description": "Ask for context, answer a coding agent’s question, or send it to the right person."
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "im:write",
        "im:history",
        "channels:history",
        "users:read",
        "users:read.email",
        "app_mentions:read",
        "assistant:write",
        "search:read.public"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://your-raven-host/webhooks/slack",
      "bot_events": [
        "message.im",
        "message.channels",
        "app_mention"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false
  }
}
