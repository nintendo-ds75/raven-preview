# Optional: defaults work without creating .env. Keep passwords URL-safe.
POSTGRES_PASSWORD=raven-local-development
RAVEN_PORT=7333
RAVEN_PUBLIC_URL=http://localhost:7333
RAVEN_DEMO=0
RAVEN_DEV_LOGIN=1
# Optional headless workspace creation. ./setup --workspace "Your team" sets this.
RAVEN_WORKSPACE_NAME=
RAVEN_MODEL_API=none
# Docker includes a local learned embedding model. Organization text stays local.
# RAVEN_EMBEDDINGS=local
# RAVEN_INSTALL_SEMANTIC=true
# RAVEN_MODEL=claude-sonnet-5
# RAVEN_FAST_MODEL=claude-haiku-4-5-20251001
# Optional: auto-index one existing checkout from this host directory on ./dev up.
RAVEN_REPOS_DIR=./fixtures
# RAVEN_INGEST_REPO_DIR=platform
# RAVEN_INGEST_REPO=acme/platform
# Optional managed execution (./setup --configure handles both switches).
RAVEN_INSTALL_AGENTS=false
RAVEN_AGENTS=0
# Optional browser agent, independent of Claude Code or Codex. See docs/browser-tasks.md.
RAVEN_WORKBENCH=0
# Set RAVEN_MODEL_API=anthropic and ANTHROPIC_API_KEY for browser execution.
# RAVEN_WORKBENCH_IMAGE=python:3.13-slim-bookworm
# Optional connections can be configured with ./setup --configure.
# Optional custom app override: set BOTH public identifiers; built-in Raven app is the default.
# See docs/github-connection.md. Never put app private keys in release configuration.
# RAVEN_GITHUB_APP_CLIENT_ID=
# RAVEN_GITHUB_APP_SLUG=
# GITHUB_TOKEN=
# RAVEN_GITHUB_REPOS=owner/repository
# ANTHROPIC_API_KEY=
# Optional explicit workspace for multi-workspace keys; not an API key.
# ANTHROPIC_WORKSPACE_ID=
# OPENAI_API_KEY=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_FALLBACK_CHANNEL=
# TEAMS_WEBHOOK_URL=
# RAVEN_GITHUB_CLIENT_ID=
# RAVEN_GITHUB_CLIENT_SECRET=
# RAVEN_GITHUB_ORG=

# Optional Teams channel bot with verified replies. Separate from TEAMS_WEBHOOK_URL.
# See docs/teams.md; registration, identity mapping and live tenant testing required.
# RAVEN_INSTALL_TEAMS=true
# TEAMS_APP_ID=
# TEAMS_TENANT_ID=
# TEAMS_CLIENT_SECRET=
# TEAMS_CHANNEL_ID=
# TEAMS_PEOPLE_JSON={"entra-object-uuid":"raven-person-id"}
# TEAMS_SERVICE_URL=https://smba.trafficmanager.net/teams/

# Optional shared-context retrieval. Configure collections separately; see docs/context-connectors.md.
# RAVEN_AIRWEAVE_URL=https://your-airweave-api.example
# AIRWEAVE_API_KEY=
# Optional native context sources (opt-in per channel/project/site); see docs/context-sources.md.
# Jira Cloud API token for projects added with: python -m raven.sources add jira ...
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# RAVEN_SOURCE_SYNC_MINUTES=15
# RAVEN_SLACK_BACKFILL_DAYS=30
# RAVEN_SLACK_THREAD_DAYS=14
# RAVEN_JIRA_BACKFILL_DAYS=90
# Coding-host hooks need Python 3 locally; set 0 for instruction-only MCP.
# RAVEN_HOST_HOOKS=1
