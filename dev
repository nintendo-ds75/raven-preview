#!/bin/sh
# Docker-only development commands; no host Python, Make, or Xcode required.
set -eu
cd "$(dirname "$0")"
action=${1:-up}
case "$action" in
  setup) shift; exec ./setup "$@" ;;
  config) shift; exec ./setup --configure "$@" ;;
  up)
    docker compose up --build -d --wait
    # Print the URL the server was configured with, not the port mapping:
    # the container binds 7333 whatever port is published, and a Host the
    # server was not told about is refused with 403. Asking the container
    # keeps the printed link and the accepted host the same thing.
    raven_port=$(docker compose port app 7333); raven_port=${raven_port##*:}
    # Some Docker Desktop/Compose versions report :0 despite a real host binding.
    if [ "$raven_port" = 0 ]; then
      raven_port=$(docker inspect "$(docker compose ps -q app)" \
        --format '{{(index (index .NetworkSettings.Ports "7333/tcp") 0).HostPort}}' 2>/dev/null) || raven_port=''
    fi
    case "$raven_port" in ''|*[!0-9]*) raven_port=7333 ;; esac
    raven_url=$(docker compose exec -T app printenv RAVEN_PUBLIC_URL 2>/dev/null | tr -d '\r\n')
    case "$raven_url" in
      *:"$raven_port") ;;
      *)
        echo "Warning: this Raven is published on port $raven_port but configured as ${raven_url:-nothing}."
        echo "Sign-in links and the accepted host will be wrong. Run ./setup --port $raven_port to line them up."
        raven_url="http://localhost:$raven_port" ;;
    esac
    echo "Raven: $raven_url"
    if [ -t 1 ] && docker compose exec -T -u raven app sh -c 'test "$RAVEN_DEV_LOGIN" = 1 && test -s /data/dev-login-token'; then
      ./dev login
    else
      echo 'First workspace setup credential: ./dev login. Existing users sign in with their account.'
    fi
    ;;
  down) docker compose down ;;
  status) docker compose ps ;;
  logs) docker compose logs -f app ;;
  login) docker compose exec -T -u raven app python -m raven dev-login ;;
  mcp) docker compose exec -T -u raven app python -m raven mcp ;;
  seed) docker compose exec -T app python -m raven.bootstrap ;;
  import-sqlite)
    test "$#" -eq 2 || { echo 'Usage: ./dev import-sqlite /absolute/path/to/raven.db'; exit 1; }
    case "$2" in /*) ;; *) echo 'Use an absolute source path'; exit 1 ;; esac
    test -f "$2"
    docker compose up -d --wait db
    docker compose run --build --rm -v "$(dirname "$2"):/import:ro" --entrypoint python app \
      -m raven.import_sqlite "/import/$(basename "$2")"
    ;;
  shell) docker compose exec app sh ;;
  db) docker compose exec db psql -U raven -d raven ;;
  test) docker compose exec -T app python -m unittest discover -s tests -q ;;
  test-postgres)
    docker compose exec -T -e RAVEN_TEST_POSTGRES=1 app python -m unittest discover -s tests -p test_postgres.py -v
    ;;
  ingest)
    test "$#" -ge 2 || { echo 'Usage: ./dev ingest directory-name [owner/repository]'; exit 1; }
    docker compose exec -T app python -m raven ingest "/repos/$2" --repo "${3:-$2}"
    ;;
  backup)
    mkdir -p backups
    backup_file="backups/raven-$(date +%Y%m%d-%H%M%S).dump"
    docker compose exec -T db pg_dump -U raven -d raven -Fc > "$backup_file"
    echo "$backup_file"
    ;;
  restore)
    test "$#" -eq 3 || { echo 'Usage: ./dev restore backups/file.dump new_database_name'; exit 1; }
    test -f "$2"
    docker compose exec -T db createdb -U raven "$3"
    docker compose exec -T db pg_restore -U raven -d "$3" --exit-on-error < "$2"
    ;;
  *) echo 'Usage: ./dev {setup|config|up|down|status|logs|login|mcp|seed|import-sqlite|shell|db|test|test-postgres|ingest|backup|restore}'; exit 1 ;;
esac
