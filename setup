#!/usr/bin/env bash
# One entry point for macOS, Linux, and Windows through WSL.
set -euo pipefail
cd "$(dirname "$0")"
setup_root=$PWD
setup_args=()
setup_import=''
setup_repo=''
setup_project=''
setup_yes=0
setup_configure=0
setup_headless=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h)
      printf '%s\n' 'Usage: ./setup [options]' \
        '' \
        'No options: build and start Raven with Docker, then open the browser setup.' \
        '' \
        '  --configure                 Ask about agent clients, Slack and model settings (saved privately in .env)' \
        '  --project PATH              Your coding checkout; with --configure, installs the MCP config and hooks there' \
        '  --client NAME               claude, codex or cursor: connect it with no questions asked (repeatable; needs no terminal)' \
        '  --repo PATH                 Ingest a local Git checkout for ownership signals' \
        '  --repo-name OWNER/NAME      The repository identity agents will use (with --repo)' \
        '  --workspace NAME            Create the workspace without a browser or personal account' \
        '  --demo                      Add sample tasks and people to an empty workspace' \
        '  --port PORT                 Publish on another port (default 7333)' \
        '  --import-sqlite FILE        Import a SQLite database into an empty PostgreSQL' \
        '  --yes                       Use saved settings without prompts' \
        '' \
        'Afterwards: ./dev status | logs | down | up | login | backup'
      exit 0 ;;
    --project)
      [ "$#" -ge 2 ] || { echo '--project needs your coding checkout path' >&2; exit 1; }
      setup_project=$(cd "$2" && pwd); shift 2 ;;
    --repo)
      [ "$#" -ge 2 ] || { echo '--repo needs a checkout path' >&2; exit 1; }
      setup_repo=$(cd "$2" && pwd)
      [ -e "$setup_repo/.git" ] || { echo 'Repository must be a Git checkout' >&2; exit 1; }
      [ -d "$setup_repo/.git" ] || { echo 'Use a standalone Git clone; linked worktrees need additional Git metadata mounts.' >&2; exit 1; }
      setup_args+=(--repo "$setup_repo"); shift 2 ;;
    --import-sqlite)
      [ "$#" -ge 2 ] && [ -f "$2" ] || { echo '--import-sqlite needs an existing database file' >&2; exit 1; }
      setup_import="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"
      shift 2 ;;
    --workspace)
      [ "$#" -ge 2 ] || { echo "--workspace needs a name" >&2; exit 1; }
      setup_headless=1; setup_args+=("$1" "$2"); shift 2 ;;
    --repo-name|--port|--client)
      [ "$#" -ge 2 ] || { echo "$1 needs a value" >&2; exit 1; }
      setup_args+=("$1" "$2"); shift 2 ;;
    --yes) setup_yes=1; setup_args+=("$1"); shift ;;
    --configure) setup_configure=1; setup_args+=("$1"); shift ;;
    --demo) setup_args+=("$1"); shift ;;
    *) echo "Unknown option: $1 (see ./setup --help)" >&2; exit 1 ;;
  esac
done
if [ "$setup_configure" -eq 0 ] && [ -z "$setup_repo" ] && [ "$setup_yes" -eq 0 ]; then
  setup_args+=(--yes)
fi
setup_agent_project=${setup_project:-$setup_repo}
command -v docker >/dev/null || { echo 'Install Docker Desktop (macOS/Windows) or Docker Engine with Compose v2 (Linux), then rerun ./setup.' >&2; exit 1; }
docker compose version >/dev/null 2>&1 || { echo 'Docker Compose v2 is required. Update Docker, then rerun ./setup.' >&2; exit 1; }
docker info >/dev/null 2>&1 || { echo 'Start Docker Desktop or the Docker daemon, then rerun ./setup.' >&2; exit 1; }
echo 'Preparing the setup runtime…'
docker compose build app || { echo 'Build failed. Check Docker network access and the build error above, then rerun ./setup.' >&2; exit 1; }
setup_tty=()
if [ ! -t 0 ] || [ ! -t 1 ]; then setup_tty=(-T); fi
# Bash 3.2 (shipped with macOS) treats empty arrays as unset with nounset.
docker compose run --rm --no-deps ${setup_tty[@]+"${setup_tty[@]}"} --user "$(id -u):$(id -g)" \
  -v "$setup_root:/workspace" \
  -w /workspace --entrypoint python app \
  -m bridge.setup ${setup_args[@]+"${setup_args[@]}"}
if [ -n "$setup_import" ]; then ./dev import-sqlite "$setup_import"; fi
./dev up || { echo 'Startup failed. Run ./dev logs and ./dev status for details; your data is retained.' >&2; exit 1; }
if grep -Eq "^BRIDGE_MCP_CLIENTS='[^']+" .env; then
  if [ -z "$setup_agent_project" ]; then
    setup_agent_project=$(docker compose run --rm --no-deps -T -v "$setup_root:/workspace" -w /workspace --entrypoint python app -c 'from pathlib import Path; from bridge.setup import read_settings; print(read_settings(Path(".env")).get("BRIDGE_AGENT_PROJECT", ""))')
  fi
  if [ -z "$setup_agent_project" ] && [ -t 0 ] && [ -t 1 ]; then
    read -r -p 'Path to the project your coding agent works in: ' setup_agent_project
  fi
  if [ -z "$setup_agent_project" ]; then
    echo 'To connect your coding project, run: ./setup --configure --project /path/to/your/project'
    exit 0
  fi
  setup_agent_project=$(cd "$setup_agent_project" && pwd)
  docker compose exec -T -u bridge app cat /data/dev-agent-token | docker compose run --rm --no-deps -T --user "$(id -u):$(id -g)" \
    -e "BRIDGE_AGENT_PROJECT_HOST=$setup_agent_project" -v "$setup_root:/workspace" -v "$setup_agent_project:/agent-project" \
    -w /workspace --entrypoint python app -m bridge.setup --connect-mcp
fi
setup_url=$(docker compose exec -T app printenv BRIDGE_PUBLIC_URL 2>/dev/null | tr -d '\r\n')
setup_url="${setup_url%/}"
echo
echo 'Raven is running.'
echo "  Open:              $setup_url"
if [ "$setup_headless" -eq 0 ]; then
  echo '  First sign-in:     ./dev login   (prints the one-time setup credential the browser asks for)'
fi
if ! grep -Eq "^BRIDGE_MCP_CLIENTS='[^']+" .env; then
  echo '  Connect an agent:  ./setup --configure --project /path/to/your/code'
fi
echo '  Later:             ./dev status · ./dev logs · ./dev down · ./dev up'
echo '  Guide:             docs/getting-started.md'
if [ "$setup_yes" -eq 0 ] && [ "$setup_headless" -eq 0 ]; then
  setup_url="$setup_url/#connect"
  echo "Opening $setup_url"
  if command -v open >/dev/null 2>&1; then
    open "$setup_url" || echo "Open $setup_url in your browser to continue."
  elif command -v wslview >/dev/null 2>&1; then
    wslview "$setup_url" || echo "Open $setup_url in your browser to continue."
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$setup_url" >/dev/null 2>&1 || echo "Open $setup_url in your browser to continue."
  else
    echo "Open $setup_url in your browser to continue."
  fi
fi
