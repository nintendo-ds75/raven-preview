+def _make_leeway(leeway: int) -> int:
+    """Validate and return a leeway value in seconds.
+
+    :param leeway: A non-negative integer number of seconds.
+    :raises TypeError: If *leeway* is not a plain :class:`int`
+        (including :class:`bool`, which is rejected).
+    :raises ValueError: If *leeway* is negative.
+    """
+    # bool is a subclass of int but must be rejected to avoid silent
+    # misuse (e.g. leeway=True meaning 1 second).
+    if not isinstance(leeway, int) or isinstance(leeway, bool):
+        raise TypeError(
+            f"'leeway' must be an int, not {type(leeway).__name__!r}."
+        )
+
+    if leeway < 0:
+        raise ValueError("'leeway' must not be negative.")
+
+    return leeway
+
+
