+    # --- leeway tests ---
+
+    def test_leeway_within_window(self, signer, freeze):
+        """A token within max_age is still accepted with leeway=0."""
+        signed = signer.sign("value")
+        freeze.tick(timedelta(seconds=5))
+        assert signer.unsign(signed, max_age=10, leeway=0) == b"value"
+
+    def test_leeway_extends_old_direction(self, signer, freeze):
+        """A token just past max_age is accepted when leeway covers the gap."""
+        signed = signer.sign("value")
+        freeze.tick(timedelta(seconds=12))  # age = 12, max_age = 10, leeway = 5
+        assert signer.unsign(signed, max_age=10, leeway=5) == b"value"
+
+    def test_leeway_does_not_extend_enough(self, signer, freeze):
+        """A token well past max_age+leeway is still rejected."""
+        signed = signer.sign("value")
+        freeze.tick(timedelta(seconds=20))  # age = 20 > max_age(10) + leeway(5)
+        with pytest.raises(SignatureExpired):
+            signer.unsign(signed, max_age=10, leeway=5)
+
+    def test_leeway_covers_future_skew(self, signer, ts, freeze):
+        """A token signed slightly in the future (clock skew) is accepted within leeway."""
+        signed = signer.sign("value")
+        # Wind the verifier's clock back 3 s so the token appears 3 s in the future.
+        with freeze_time(ts - timedelta(seconds=3)):
+            assert signer.unsign(signed, max_age=10, leeway=5) == b"value"
+
+    def test_leeway_future_beyond_leeway_rejected(self, signer):
+        """A token far in the future (beyond leeway) is still rejected."""
+        signed = signer.sign("value")
+        with freeze_time("1971-05-31"):  # very far in the past relative to token
+            with pytest.raises(SignatureExpired):
+                signer.unsign(signed, max_age=10, leeway=5)
+
+    def test_leeway_zero_default_unchanged(self, signer, freeze):
+        """leeway=0 (default) preserves the original strict boundary."""
+        signed = signer.sign("value")
+        freeze.tick(timedelta(seconds=11))  # age = 11 > max_age = 10
+        with pytest.raises(SignatureExpired):
+            signer.unsign(signed, max_age=10)
+
+    def test_leeway_requires_max_age(self, signer):
+        """Raises ValueError when leeway > 0 but max_age is None."""
+        signed = signer.sign("value")
+        with pytest.raises(ValueError, match="max_age"):
+            signer.unsign(signed, leeway=5)
+
+    def test_leeway_zero_no_max_age_ok(self, signer):
+        """leeway=0 with max_age=None is fine (existing default behaviour)."""
+        signed = signer.sign("value")
+        assert signer.unsign(signed, leeway=0) == b"value"
+
+    def test_leeway_negative_raises(self, signer):
+        """Negative leeway raises ValueError."""
+        signed = signer.sign("value")
+        with pytest.raises(ValueError, match="negative"):
+            signer.unsign(signed, max_age=10, leeway=-1)
+
+    def test_leeway_bool_raises(self, signer):
+        """bool is rejected with TypeError (bool is a subclass of int)."""
+        signed = signer.sign("value")
+        with pytest.raises(TypeError):
+            signer.unsign(signed, max_age=10, leeway=True)
+
+    def test_leeway_float_raises(self, signer):
+        """float is rejected with TypeError."""
+        signed = signer.sign("value")
+        with pytest.raises(TypeError):
+            signer.unsign(signed, max_age=10, leeway=1.5)
+
+    def test_leeway_validate(self, signer, freeze):
+        """validate() passes leeway through to unsign()."""
+        signed = signer.sign("value")
+        freeze.tick(timedelta(seconds=12))
+        assert signer.validate(signed, max_age=10, leeway=5) is True
+        assert signer.validate(signed, max_age=10, leeway=0) is False
+
+    def test_leeway_validate_missing_max_age_raises(self, signer):
+        """validate() propagates ValueError when leeway>0 and max_age is None.
+        This is a programming error, not a bad-signature condition."""
+        signed = signer.sign("value")
+        with pytest.raises(ValueError, match="max_age"):
+            signer.validate(signed, leeway=5)
