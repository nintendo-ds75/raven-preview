+@parametrize_families
+def test_junit_output_limit_disabled_by_default(
+    pytester: Pytester, run_and_parse: RunAndParse, xunit_family: str
+) -> None:
+    """By default no truncation happens, preserving previous behavior."""
+    pytester.makeini(
+        f"""
+        [pytest]
+        junit_logging=system-out
+        junit_family={xunit_family}
+    """
+    )
+    pytester.makepyfile(
+        """
+        def test_func():
+            print("x" * 1000)
+    """
+    )
+    result, dom = run_and_parse(family=xunit_family)
+    assert result.ret == 0
+    node = dom.get_first_by_tag("testcase")
+    system_out = node.get_first_by_tag("system-out")
+    assert "x" * 1000 in system_out.text
+
+
+@parametrize_families
+def test_junit_output_limit_truncates_keeping_only_the_start(
+    pytester: Pytester, run_and_parse: RunAndParse, xunit_family: str
+) -> None:
+    """junit_output_limit truncates each captured output section
+    independently, keeping only the first N Unicode characters and
+    appending a fixed truncation marker (no tail retention)."""
+    pytester.makeini(
+        f"""
+        [pytest]
+        junit_logging=out-err
+        junit_output_limit=50
+        junit_family={xunit_family}
+    """
+    )
+    pytester.makepyfile(
+        """
+        import sys
+
+        def test_func():
+            sys.stdout.write("o" * 1000)
+            sys.stderr.write("e" * 1000)
+    """
+    )
+    result, dom = run_and_parse(family=xunit_family)
+    assert result.ret == 0
+    node = dom.get_first_by_tag("testcase")
+
+    system_out = node.get_first_by_tag("system-out")
+    assert "o" * 50 + "\n[... output truncated ...]\n" in system_out.text
+    assert "o" * 51 not in system_out.text
+
+    system_err = node.get_first_by_tag("system-err")
+    assert "e" * 50 + "\n[... output truncated ...]\n" in system_err.text
+    assert "e" * 51 not in system_err.text
+
+
+@parametrize_families
+def test_junit_output_limit_applies_equally_to_failed_tests(
+    pytester: Pytester, run_and_parse: RunAndParse, xunit_family: str
+) -> None:
+    """Captured output is truncated the same way for passing and failing
+    tests, but the <failure> diagnostic text itself is never truncated."""
+    pytester.makeini(
+        f"""
+        [pytest]
+        junit_logging=system-out
+        junit_output_limit=10
+        junit_family={xunit_family}
+    """
+    )
+    pytester.makepyfile(
+        """
+        import sys
+
+        def test_func():
+            sys.stdout.write("x" * 1000)
+            assert False, "y" * 1000
+    """
+    )
+    result, dom = run_and_parse(family=xunit_family)
+    assert result.ret == 1
+    node = dom.get_first_by_tag("testcase")
+
+    system_out = node.get_first_by_tag("system-out")
+    assert "x" * 10 + "\n[... output truncated ...]\n" in system_out.text
+    assert "x" * 11 not in system_out.text
+
+    failure = node.get_first_by_tag("failure")
+    assert "y" * 1000 in failure.text
+    assert "truncated" not in failure.text
+
+
+def test_junit_output_limit_unicode(
+    pytester: Pytester, run_and_parse: RunAndParse
+) -> None:
+    """Truncation operates on Unicode code points, never splitting a
+    multi-byte character."""
+    pytester.makeini(
+        """
+        [pytest]
+        junit_logging=system-out
+        junit_output_limit=20
+    """
+    )
+    pytester.makepyfile(
+        """
+        # -*- coding: utf-8 -*-
+        def test_func():
+            print("é" * 100)
+    """
+    )
+    result, dom = run_and_parse()
+    assert result.ret == 0
+    node = dom.get_first_by_tag("testcase")
+    system_out = node.get_first_by_tag("system-out")
+    assert "é" * 20 + "\n[... output truncated ...]\n" in system_out.text
+    assert "é" * 21 not in system_out.text
+    # No mangled byte of the "é" UTF-8 encoding anywhere in the output.
+    import string
+
+    allowed = string.ascii_letters + string.digits + string.punctuation + " \n"
+    for ch in system_out.text:
+        assert ch == "é" or ch in allowed
+
+
+def test_junit_output_limit_rejects_non_integer(pytester: Pytester) -> None:
+    pytester.makeini(
+        """
+        [pytest]
+        junit_output_limit=not-a-number
+    """
+    )
+    pytester.makepyfile("def test_func(): pass")
+    xml_path = pytester.path.joinpath("junit.xml")
+    result = pytester.runpytest(f"--junitxml={xml_path}")
+    assert result.ret == pytest.ExitCode.USAGE_ERROR
+    result.stderr.fnmatch_lines(
+        ["*junit_output_limit must be an integer, got 'not-a-number'*"]
+    )
+
+
+def test_junit_output_limit_rejects_negative(pytester: Pytester) -> None:
+    pytester.makeini(
+        """
+        [pytest]
+        junit_output_limit=-1
+    """
+    )
+    pytester.makepyfile("def test_func(): pass")
+    xml_path = pytester.path.joinpath("junit.xml")
+    result = pytester.runpytest(f"--junitxml={xml_path}")
+    assert result.ret == pytest.ExitCode.USAGE_ERROR
+    result.stderr.fnmatch_lines(
+        ["*junit_output_limit must be a non-negative integer, got -1*"]
+    )
+
