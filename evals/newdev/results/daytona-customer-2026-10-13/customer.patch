diff --git a/tests/test_itsdangerous/test_timed.py b/tests/test_itsdangerous/test_timed.py
index a4c1741..7db13ea 100644
--- a/tests/test_itsdangerous/test_timed.py
+++ b/tests/test_itsdangerous/test_timed.py
@@ -113,3 +113,110 @@ class TestTimedSerializer(FreezeMixin, TestSerializer):
     def test_return_payload(self, serializer, value, ts):
         signed = serializer.dumps(value)
         assert serializer.loads(signed, return_timestamp=True) == (value, ts)
+
+    # ---- default_max_age tests ----------------------------------------
+
+    def test_default_max_age_none_is_default(self, serializer_factory, value, ts, freeze):
+        """default_max_age defaults to None, so no age check by default."""
+        s = serializer_factory()
+        assert s.default_max_age is None
+        signed = s.dumps(value)
+        freeze.tick(timedelta(seconds=3600))
+        # No age limit set: loads without error
+        assert s.loads(signed) == value
+
+    def test_default_max_age_enforced(self, serializer_factory, value, ts, freeze):
+        """Tokens older than default_max_age are rejected."""
+        s = serializer_factory(default_max_age=10)
+        signed = s.dumps(value)
+        freeze.tick()
+        assert s.loads(signed) == value  # 1 second old, still valid
+        freeze.tick(timedelta(seconds=10))
+
+        with pytest.raises(SignatureExpired) as exc_info:
+            s.loads(signed)
+
+        assert exc_info.value.date_signed == ts
+
+    def test_default_max_age_overridden_per_call(self, serializer_factory, value, ts, freeze):
+        """Per-call max_age overrides the instance default."""
+        s = serializer_factory(default_max_age=5)
+        signed = s.dumps(value)
+        freeze.tick(timedelta(seconds=3))
+        # Per-call override of 60 accepts a 3-second-old token.
+        assert s.loads(signed, max_age=60) == value
+
+    def test_default_max_age_none_falls_through(self, serializer_factory, value, freeze):
+        """Passing max_age=None explicitly still uses the instance default
+        (None-falls-through semantics: None means 'use default_max_age')."""
+        s = serializer_factory(default_max_age=5)
+        signed = s.dumps(value)
+        freeze.tick(timedelta(seconds=100))
+        # max_age=None still falls through to default_max_age=5, so the token
+        # is expired and SignatureExpired is raised.
+        with pytest.raises(SignatureExpired):
+            s.loads(signed, max_age=None)
+
+    def test_default_max_age_zero(self, serializer_factory, value, freeze):
+        """default_max_age=0 rejects all tokens immediately after signing."""
+        s = serializer_factory(default_max_age=0)
+        signed = s.dumps(value)
+        freeze.tick()
+
+        with pytest.raises(SignatureExpired):
+            s.loads(signed)
+
+    def test_default_max_age_negative_raises(self, serializer_factory):
+        """Negative default_max_age raises ValueError at construction."""
+        with pytest.raises(ValueError, match="non-negative"):
+            serializer_factory(default_max_age=-1)
+
+    def test_default_max_age_loads_unsafe(self, serializer_factory, value, freeze):
+        """loads_unsafe also respects default_max_age."""
+        s = serializer_factory(default_max_age=5)
+        signed = s.dumps(value)
+        freeze.tick(timedelta(seconds=100))
+        # The token is expired; loads_unsafe returns (False, payload).
+        ok, payload = s.loads_unsafe(signed)
+        assert not ok
+
+    def test_default_max_age_loads_unsafe_none_falls_through(self, serializer_factory, value, freeze):
+        """Passing max_age=None to loads_unsafe still uses default_max_age
+        (None-falls-through: None means 'use instance default')."""
+        s = serializer_factory(default_max_age=5)
+        signed = s.dumps(value)
+        freeze.tick(timedelta(seconds=100))
+        # max_age=None still applies the default limit; token is expired.
+        ok, payload = s.loads_unsafe(signed, max_age=None)
+        assert not ok
+
+    def test_default_max_age_fallback_signers(self, serializer_factory, value, freeze):
+        """default_max_age applies uniformly including the fallback-signer path.
+
+        Sign with sha256 so the sha1 primary signer cannot verify it.
+        Load via a serializer that has sha1 as primary and sha256 as fallback.
+        The age limit must be enforced even when the token is only accepted by
+        a fallback signer, not silently bypassed because the primary failed.
+        """
+        import hashlib
+
+        # Produce a token signed with sha256.
+        signer_sha256 = serializer_factory(
+            signer_kwargs={"digest_method": hashlib.sha256},
+        )
+        signed = signer_sha256.dumps(value)
+
+        # Verifier: sha1 primary (fails for sha256 tokens) + sha256 fallback.
+        s = serializer_factory(
+            default_max_age=10,
+            fallback_signers=[{"digest_method": hashlib.sha256}],
+        )
+
+        # 5 seconds in: within the limit; accepted via the fallback signer.
+        freeze.tick(timedelta(seconds=5))
+        assert s.loads(signed) == value
+
+        # 11 seconds in: past the limit; fallback signer must also reject it.
+        freeze.tick(timedelta(seconds=6))
+        with pytest.raises(SignatureExpired):
+            s.loads(signed)
