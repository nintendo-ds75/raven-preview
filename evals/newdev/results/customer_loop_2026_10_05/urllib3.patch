diff --git a/test/test_retry.py b/test/test_retry.py
index 48ca072..90c55a0 100644
--- a/test/test_retry.py
+++ b/test/test_retry.py
@@ -456,3 +456,133 @@ class TestRetry:
                 sleep_mock.assert_called_with(sleep_duration)
             else:
                 sleep_mock.assert_not_called()
+
+    def test_retry_after_jitter_defaults_to_disabled(self) -> None:
+        """By default a Retry-After wait is exactly what the server asked for"""
+        retry = Retry()
+        assert retry.retry_after_jitter == 0.0
+
+        response = HTTPResponse(status=503, headers={"Retry-After": "7"})
+        with (
+            mock.patch("time.sleep") as sleep_mock,
+            mock.patch("random.uniform") as uniform_mock,
+        ):
+            retry.sleep(response)
+
+        sleep_mock.assert_called_once_with(7)
+        uniform_mock.assert_not_called()
+
+    def test_retry_after_jitter_only_lengthens_the_wait(self) -> None:
+        """Jitter is sampled from [0, retry_after_jitter] and never shortens"""
+        retry = Retry(retry_after_jitter=2.5)
+        response = HTTPResponse(status=503, headers={"Retry-After": "7"})
+
+        durations = []
+        for _ in range(100):
+            with mock.patch("time.sleep") as sleep_mock:
+                retry.sleep(response)
+            (duration,), _ = sleep_mock.call_args
+            durations.append(duration)
+
+        assert all(7 <= duration <= 9.5 for duration in durations)
+        # The waits are actually spread out, not all identical.
+        assert len(set(durations)) > 1
+
+    def test_retry_after_jitter_bounds(self) -> None:
+        """The sampled jitter spans the whole configured interval"""
+        retry = Retry(retry_after_jitter=2.5)
+        response = HTTPResponse(status=503, headers={"Retry-After": "7"})
+
+        for sampled, expected in ((0.0, 7), (2.5, 9.5)):
+            with (
+                mock.patch("random.uniform", return_value=sampled) as uniform_mock,
+                mock.patch("time.sleep") as sleep_mock,
+            ):
+                retry.sleep(response)
+            uniform_mock.assert_called_once_with(0, 2.5)
+            sleep_mock.assert_called_once_with(expected)
+
+    def test_retry_after_jitter_is_capped_by_retry_after_max(self) -> None:
+        """The jittered wait never exceeds the configured retry_after_max"""
+        retry = Retry(retry_after_max=10, retry_after_jitter=5)
+        response = HTTPResponse(status=503, headers={"Retry-After": "10"})
+
+        with (
+            mock.patch("random.uniform", return_value=5.0),
+            mock.patch("time.sleep") as sleep_mock,
+        ):
+            retry.sleep(response)
+        sleep_mock.assert_called_once_with(10)
+
+        # Below the cap the jitter is applied in full.
+        response = HTTPResponse(status=503, headers={"Retry-After": "6"})
+        with (
+            mock.patch("random.uniform", return_value=3.0),
+            mock.patch("time.sleep") as sleep_mock,
+        ):
+            retry.sleep(response)
+        sleep_mock.assert_called_once_with(9)
+
+    def test_retry_after_jitter_keeps_accessors_deterministic(self) -> None:
+        """parse_retry_after()/get_retry_after() return the server's value"""
+        retry = Retry(retry_after_jitter=5)
+        response = HTTPResponse(status=503, headers={"Retry-After": "7"})
+
+        assert retry.parse_retry_after("7") == 7
+        assert retry.get_retry_after(response) == 7
+
+    def test_retry_after_jitter_does_not_apply_without_retry_after(self) -> None:
+        """Without a usable Retry-After we fall back to exponential backoff"""
+        retry = Retry(total=100, backoff_factor=0.2, retry_after_jitter=5)
+        retry = retry.increment(method="GET")
+        retry = retry.increment(method="GET")
+
+        # No Retry-After header at all.
+        response = HTTPResponse(status=503)
+        with (
+            mock.patch("random.uniform") as uniform_mock,
+            mock.patch("time.sleep") as sleep_mock,
+        ):
+            retry.sleep(response)
+        uniform_mock.assert_not_called()
+        sleep_mock.assert_called_once_with(0.4)
+
+        # Retry-After present but already elapsed.
+        response = HTTPResponse(status=503, headers={"Retry-After": "0"})
+        with (
+            mock.patch("random.uniform") as uniform_mock,
+            mock.patch("time.sleep") as sleep_mock,
+        ):
+            retry.sleep(response)
+        uniform_mock.assert_not_called()
+        sleep_mock.assert_called_once_with(0.4)
+
+    def test_retry_after_jitter_skips_non_positive_waits(self) -> None:
+        """A non-positive delay is never turned into a jitter sleep"""
+        retry = Retry(retry_after_jitter=5)
+
+        with mock.patch("random.uniform") as uniform_mock:
+            assert retry._jitter_retry_after(0) == 0
+            assert retry._jitter_retry_after(-1) == -1
+        uniform_mock.assert_not_called()
+
+    def test_retry_after_jitter_does_not_affect_backoff(self) -> None:
+        """retry_after_jitter leaves the exponential backoff untouched"""
+        retry = Retry(total=100, backoff_factor=0.2, retry_after_jitter=5)
+        retry = retry.increment(method="GET")
+        retry = retry.increment(method="GET")
+        assert retry.get_backoff_time() == 0.4
+
+    def test_retry_after_jitter_survives_new_and_increment(self) -> None:
+        retry = Retry(total=3, retry_after_jitter=1.5)
+        assert retry.new().retry_after_jitter == 1.5
+        assert retry.increment(method="GET").retry_after_jitter == 1.5
+
+    @pytest.mark.parametrize(
+        "retry_after_jitter", [-1, -0.001, float("nan"), float("inf")]
+    )
+    def test_retry_after_jitter_rejects_invalid_values(
+        self, retry_after_jitter: float
+    ) -> None:
+        with pytest.raises(ValueError, match="retry_after_jitter"):
+            Retry(retry_after_jitter=retry_after_jitter)
