+    def _jitter_retry_after(self, retry_after: float) -> float:
+        """Add the configured jitter to a server-requested delay.
+
+        Jitter is additive only, so the delay the server asked for is never
+        shortened, and the jittered result is still limited by
+        ``retry_after_max``.
+        """
+        if not self.retry_after_jitter or retry_after <= 0:
+            return retry_after
+
+        retry_after += random.uniform(0, self.retry_after_jitter)
+        return min(retry_after, self.retry_after_max)
