# Optional real open-source harnesses. The normal Python image stays unchanged.
# Build raven-core-base with the root Dockerfile first (see execution-harnesses.md).
ARG RAVEN_BASE_IMAGE=raven-core-base
FROM node:22.19.0-bookworm-slim AS node_runtime
FROM ${RAVEN_BASE_IMAGE}
USER root
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node_runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && npm ci --prefix /app/hosts/pi --ignore-scripts \
    && npm ci --prefix /app/hosts/opencode --ignore-scripts \
    && npm ci --prefix /app/hosts/codex --ignore-scripts \
    && npm cache clean --force \
    && chmod -R a+rX /app/hosts
USER bridge
